<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup for devices below API 31. Above that, data_extraction_rules.xml applies.

     EdgeCasePrefs holds everything the user ever configures: the ordered shortcut list, the
     sliver's side and vertical position, and all 15 appearance/geometry keys. Without this a
     reinstall silently discards the lot.

     Restoring a shortcut list onto a device that lacks some of those apps is safe:
     ShortcutStateManager filters to installed packages on load, and SidebarService skips any
     package that fails to resolve. -->
<full-backup-content>
    <include domain="sharedpref" path="EdgeCasePrefs.xml" />
</full-backup-content>

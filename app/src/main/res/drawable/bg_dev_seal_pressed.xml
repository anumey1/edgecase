<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed Seal. The bronze hairline lights to emerald and the niche lifts one step —
     the same "the gems catch the light" language used by the Serpent's Eyes and the
     Customize sliders, rather than the limestone darkening used by the slab buttons. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/limestone_border" />
        </shape>
    </item>

    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/emerald_gem" />
        </shape>
    </item>

    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/obsidian_facet" />
        </shape>
    </item>

    <item android:gravity="top|start" android:width="7dp" android:height="7dp">
        <shape android:shape="rectangle"><solid android:color="@color/limestone_border" /></shape>
    </item>
    <item android:gravity="top|end" android:width="7dp" android:height="7dp">
        <shape android:shape="rectangle"><solid android:color="@color/limestone_border" /></shape>
    </item>
    <item android:gravity="bottom|start" android:width="7dp" android:height="7dp">
        <shape android:shape="rectangle"><solid android:color="@color/limestone_border" /></shape>
    </item>
    <item android:gravity="bottom|end" android:width="7dp" android:height="7dp">
        <shape android:shape="rectangle"><solid android:color="@color/limestone_border" /></shape>
    </item>

</layer-list>
